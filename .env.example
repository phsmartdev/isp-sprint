# Banco local (docker compose up -d db)
DATABASE_URL=postgres://isp:isp@localhost:5432/isp_sprint
TEST_DATABASE_URL=postgres://isp:isp@localhost:5432/isp_sprint_test

# API
API_PORT=3333
# Origem permitida do frontend (CORS + verificação de Origin anti-CSRF)
WEB_ORIGIN=http://localhost:5173
# Em produção: true (cookie Secure, exige HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Assinatura do cookie de sessão. Obrigatório em produção (>= 32 caracteres aleatórios).
# COOKIE_SECRET=

# Integração IXC — Fase 4. Credenciais SOMENTE no backend.
IXC_MODE=mock
# IXC_BASE_URL=
# IXC_TOKEN=

# Marca da instância (mesmo código, um deploy por empresa). Vale para o build e para a API.
#   bkt    → RevOps (padrão)
#   yepnet → ISP Sprint, identidade Yepnet com imagens enviadas em Configurações → Personalização
# VITE_BRAND=bkt
